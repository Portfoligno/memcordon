[Unit]
Description=MemCordon sealed supervision control provider
Requires=memcordon-sealed-agent.socket memcordon-sealed-launcher.socket
After=local-fs.target systemd-tmpfiles-setup.service memcordon-sealed-launcher.socket

[Service]
Type=simple
ExecStart=/usr/libexec/memcordon-sealed-agent serve
User=root
Group=memcordon
KillMode=process
StateDirectory=memcordon/sealed memcordon/policy
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/memcordon /var/lib/memcordon/sealed /var/lib/memcordon/policy
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_PTRACE
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
